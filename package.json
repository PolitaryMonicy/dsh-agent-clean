{
  "name": "dsh-agent-clean",
  "version": "1.3.2",
  "description": "Remove subagent entries from DeepSeek Harness session logs without breaking the log, delete orphaned projection caches, and purge whole sessions — a CLI (dry-run by default, always with a backup) plus an optional DSH settings page (Settings → Session cleanup) that shows what needs cleaning and can clean everything automatically on the next quit.",
  "type": "module",
  "bin": {
    "dsh-agent-clean": "clean.mjs"
  },
  "main": "./plugin/index.js",
  "exports": {
    ".": "./plugin/index.js",
    "./client": "./plugin/client.js",
    "./clean": "./clean.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "clean.mjs",
    "verify_loader.mjs",
    "clean.cmd",
    "clean.sh",
    "plugin",
    "test",
    "cordis.patch.yml",
    "assets",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "icon": "./assets/icon.svg",
  "scripts": {
    "selftest": "node test/selftest.mjs",
    "probe:client": "node test/client-slot-probe.mjs",
    "probe:host": "node test/host-routes-probe.mjs",
    "prepublishOnly": "npm run selftest && npm run probe:client && npm run probe:host",
    "help": "node clean.mjs --help"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "session",
    "subagent",
    "projection-cache",
    "cleanup",
    "cli",
    "gui"
  ],
  "author": "PolitaryMonicy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PolitaryMonicy/dsh-agent-clean.git"
  },
  "homepage": "https://github.com/PolitaryMonicy/dsh-agent-clean#readme",
  "bugs": {
    "url": "https://github.com/PolitaryMonicy/dsh-agent-clean/issues"
  }
}
